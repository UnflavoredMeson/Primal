<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (c) 2026 Charles Smith
  Distributed under the MIT license. See the LICENSE file in the project root for more information.

  Adds the Vulkan backend to a Windows project when the LunarG Vulkan SDK is installed
  (the installer sets VULKAN_SDK). Without the SDK, or with /p:PrimalVulkan=false, the build
  is D3D12 only. Import after the project's ItemDefinitionGroups (they set
  AdditionalIncludeDirectories without %(...)) and before Microsoft.Cpp.targets.

  Only the headers are used: nothing links vulkan-1.lib. The engine opens vulkan-1.dll at run
  time and loads every function itself (Graphics\Vulkan\VulkanLoader.h, VK_NO_PROTOTYPES), so
  executables still start on machines without a Vulkan loader.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PrimalVulkan Condition="'$(PrimalVulkan)' == '' and '$(VULKAN_SDK)' != '' and Exists('$(VULKAN_SDK)\Include\vulkan\vulkan.h')">true</PrimalVulkan>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(PrimalVulkan)' == 'true'">
    <ClCompile>
      <!-- ThirdParty\vma: the Vulkan Memory Allocator, vendored so Windows and Linux use the same version. -->
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(VULKAN_SDK)\Include;$(MSBuildThisFileDirectory)ThirdParty\vma</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>PRIMAL_GRAPHICS_VULKAN=1;VK_NO_PROTOTYPES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
