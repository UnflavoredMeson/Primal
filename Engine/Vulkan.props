<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (c) 2026 Charles Smith
  Distributed under the MIT license. See the LICENSE file in the project root for more information.

  Adds the Vulkan backend to a Windows project when the LunarG Vulkan SDK is installed
  (the installer sets VULKAN_SDK). Without the SDK, or with /p:PrimalVulkan=false, the build
  is D3D12 only. Import after the project's ItemDefinitionGroups (they set
  AdditionalIncludeDirectories without %(...)) and before Microsoft.Cpp.targets.

  vulkan-1.dll is delay-loaded, so executables still start on machines without a Vulkan
  loader; VulkanCore.cpp loads it before the first Vulkan call.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PrimalVulkan Condition="'$(PrimalVulkan)' == '' and '$(VULKAN_SDK)' != '' and Exists('$(VULKAN_SDK)\Include\vulkan\vulkan.h')">true</PrimalVulkan>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(PrimalVulkan)' == 'true'">
    <ClCompile>
      <!-- ThirdParty\vma: the Vulkan Memory Allocator, vendored so Windows and Linux use the same version. -->
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(VULKAN_SDK)\Include;$(MSBuildThisFileDirectory)ThirdParty\vma</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>PRIMAL_GRAPHICS_VULKAN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories);$(VULKAN_SDK)\Lib</AdditionalLibraryDirectories>
      <AdditionalDependencies>vulkan-1.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>vulkan-1.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <!-- LNK4199 "/DELAYLOAD:vulkan-1.dll ignored; no imports found": expected when the target never uses graphics
           (e.g. EngineTest with PrimalEngineTest=WINDOW). -->
      <AdditionalOptions>/IGNORE:4199 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
