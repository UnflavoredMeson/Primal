    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{2bc60d31-ec9b-45ef-ac9d-aeffb3617859}</ProjectGuid>
    <RootNamespace>EngineTest</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- Which test to build (same choices as CMake's PRIMAL_ENGINE_TEST): ENTITY_COMPONENTS, WINDOW, RENDERER or SURFACES.
       Override with msbuild /p:PrimalEngineTest=WINDOW (or change the default here). -->
  <PropertyGroup>
    <PrimalEngineTest Condition="'$(PrimalEngineTest)'==''">RENDERER</PrimalEngineTest>
    <!-- Plain properties, no property function: MSBuild escapes the ';' in a property function's result, which turned
         the whole list into one /D (TEST_ENTITY_COMPONENTS defined as "0;TEST_WINDOW=0;..."). -->
    <PrimalTestEntityComponents>0</PrimalTestEntityComponents>
    <PrimalTestEntityComponents Condition="'$(PrimalEngineTest)'=='ENTITY_COMPONENTS'">1</PrimalTestEntityComponents>
    <PrimalTestWindow>0</PrimalTestWindow>
    <PrimalTestWindow Condition="'$(PrimalEngineTest)'=='WINDOW'">1</PrimalTestWindow>
    <PrimalTestRenderer>0</PrimalTestRenderer>
    <PrimalTestRenderer Condition="'$(PrimalEngineTest)'=='RENDERER'">1</PrimalTestRenderer>
    <PrimalTestSurfaces>0</PrimalTestSurfaces>
    <PrimalTestSurfaces Condition="'$(PrimalEngineTest)'=='SURFACES'">1</PrimalTestSurfaces>
    <PrimalTestDefines>TEST_ENTITY_COMPONENTS=$(PrimalTestEntityComponents);TEST_WINDOW=$(PrimalTestWindow);TEST_RENDERER=$(PrimalTestRenderer);TEST_SURFACES=$(PrimalTestSurfaces)</PrimalTestDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
	<LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
	<LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>  
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <!-- /WX; opt out with /p:PrimalWarningsAsErrors=false (CMake: PRIMAL_WARNINGS_AS_ERRORS) -->
      <TreatWarningAsError Condition="'$(PrimalWarningsAsErrors)' != 'false'">true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;$(PrimalTestDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(SolutionDir)Engine\Common\;$(SolutionDir)Engine\</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <FloatingPointModel>Fast</FloatingPointModel>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OutDir)</AdditionalLibraryDirectories>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <!-- /WX; opt out with /p:PrimalWarningsAsErrors=false (CMake: PRIMAL_WARNINGS_AS_ERRORS) -->
      <TreatWarningAsError Condition="'$(PrimalWarningsAsErrors)' != 'false'">true</TreatWarningAsError>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;$(PrimalTestDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(SolutionDir)Engine\Common\;$(SolutionDir)Engine\</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <FloatingPointModel>Fast</FloatingPointModel>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OutDir)</AdditionalLibraryDirectories>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Main.cpp" />
  </ItemGroup>
  <!-- Only the renderer test uses these (like EngineTest/CMakeLists.txt). -->
  <ItemGroup Condition="'$(PrimalEngineTest)'=='RENDERER'">
    <ClCompile Include="Lights.cpp" />
    <ClCompile Include="RenderItem.cpp" />
    <ClCompile Include="Scripts.cpp" />
    <ClCompile Include="TestRenderer.cpp" />
  </ItemGroup>
  <!-- The renderer and surfaces tests compile the engine shaders. -->
  <ItemGroup Condition="'$(PrimalEngineTest)'=='RENDERER' Or '$(PrimalEngineTest)'=='SURFACES'">
    <ClCompile Include="..\EngineDLL\ShaderCompilation.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Test.h" />
    <ClInclude Include="TestEntityComponents.h" />
    <ClInclude Include="TestRenderer.h" />
    <ClInclude Include="TestSurfaces.h" />
    <ClInclude Include="TestWindow.h" />
  </ItemGroup>
  <Import Project="$(SolutionDir)Engine\Vulkan.props" />
  <Import Project="$(SolutionDir)Engine\Modules.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="..\packages\Microsoft.Direct3D.DXC.1.9.2602.24\build\native\Microsoft.Direct3D.DXC.targets" Condition="Exists('..\packages\Microsoft.Direct3D.DXC.1.9.2602.24\build\native\Microsoft.Direct3D.DXC.targets')" />
  </ImportGroup>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>This project references NuGet package(s) that are missing on this computer. Use NuGet Package Restore to download them.  For more information, see http://go.microsoft.com/fwlink/?LinkID=322105. The missing file is {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('..\packages\Microsoft.Direct3D.DXC.1.9.2602.24\build\native\Microsoft.Direct3D.DXC.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.Direct3D.DXC.1.9.2602.24\build\native\Microsoft.Direct3D.DXC.props'))" />
    <Error Condition="!Exists('..\packages\Microsoft.Direct3D.DXC.1.9.2602.24\build\native\Microsoft.Direct3D.DXC.targets')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.Direct3D.DXC.1.9.2602.24\build\native\Microsoft.Direct3D.DXC.targets'))" />
  </Target>
  <!-- Download and unpack asset binaries -->
  <PropertyGroup>
    <DropboxZipUrl>https://www.dropbox.com/scl/fi/hdjgbdjo09nb76ni7ef1h/EngineTestAssets.zip?rlkey=iovobxovyosktny6t85vfkiwa&amp;st=42q50fbx&amp;dl=1</DropboxZipUrl>
	<ZipHash>5D130987004C874CA465FBD56E84DD04B95F3BAE53B97A08E64C3F11E1637D4A</ZipHash>
	<ZipFile>$(SolutionDir)x64\engine-test-assets.zip</ZipFile>
	<ExtractDir>$(SolutionDir)x64</ExtractDir>
	<!-- A file that only exists after a successful extract – used for incremental builds -->
	<ExtractMarker>$(ExtractDir)\.extracted</ExtractMarker>
  </PropertyGroup>
  <Target Name="CheckPrimalEngineTest" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PrimalEngineTest)'!='ENTITY_COMPONENTS' And '$(PrimalEngineTest)'!='WINDOW' And '$(PrimalEngineTest)'!='RENDERER' And '$(PrimalEngineTest)'!='SURFACES'" Text="PrimalEngineTest must be ENTITY_COMPONENTS, WINDOW, RENDERER or SURFACES (got '$(PrimalEngineTest)')." />
  </Target>
  <Target Name="DownloadAndUnpackDropbox" BeforeTargets="PrepareForBuild" Condition="!Exists('$(ExtractMarker)')">
    <Message Text="Downloading models and textures for EngineTest ..." Importance="high" />
    <Message Text="This may take a minute. Please wait ..." Importance="high" />
	<DownloadFile SourceUrl="$(DropboxZipUrl)" DestinationFolder="$(ExtractDir)" DestinationFileName="engine-test-assets.zip">
      <Output TaskParameter="DownloadedFile" PropertyName="ZipFile" />
    </DownloadFile>
    <Message Text="Verifying SHA-256 hash..." Importance="high" />
    <VerifyFileHash File="$(ZipFile)" Hash="$(ZipHash)" Algorithm="SHA256" HashEncoding="hex" />
    <Message Text="Hash OK – unpacking..." Importance="high" />
    <MakeDir Directories="$(ExtractDir)" />
    <Unzip SourceFiles="$(ZipFile)" DestinationFolder="$(ExtractDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
    <Message Text="Done." Importance="high" />
    <Delete Files="$(ZipFile)" />
    <!-- Create the marker so the target is skipped on subsequent builds -->
    <Touch Files="$(ExtractMarker)" AlwaysCreate="true" />
</Target>
</Project>